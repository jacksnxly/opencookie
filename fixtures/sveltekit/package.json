{
  "name": "@opencookie-fixtures/sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@opencookie-dev/core": "workspace:*",
    "@opencookie-dev/svelte": "workspace:*",
    "@opencookie-dev/vanilla": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "opencookieFixtureSources": [
    "vite.config.ts",
    "src/app.html",
    "src/routes/+layout.svelte",
    "src/lib/FixturePage.svelte",
    "src/lib/opencookie-store.ts",
    "src/lib/fixture-client.ts"
  ]
}
