{
  "name": "@opencookie-dev/vue",
  "version": "0.2.0",
  "description": "Vue binding for the OpenCookie headless store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksnxly/opencookie.git",
    "directory": "packages/adapters/vue"
  },
  "homepage": "https://docs.opencookie.dev",
  "bugs": {
    "url": "https://github.com/jacksnxly/opencookie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@opencookie-dev/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vue/server-renderer": "3.5.45",
    "vue": "3.5.41"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
