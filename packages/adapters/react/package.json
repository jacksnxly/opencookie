{
  "name": "@opencookie-dev/react",
  "version": "0.2.0",
  "description": "React binding for the OpenCookie headless store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksnxly/opencookie.git",
    "directory": "packages/adapters/react"
  },
  "homepage": "https://opencookie.dev",
  "bugs": {
    "url": "https://github.com/jacksnxly/opencookie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@opencookie-dev/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react-dom": "19.2.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
