{
  "name": "@opencookie-dev/nuxt",
  "version": "0.2.0",
  "description": "Nuxt module and SSR-safe runtime binding for OpenCookie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksnxly/opencookie.git",
    "directory": "packages/adapters/nuxt"
  },
  "homepage": "https://opencookie.dev",
  "bugs": {
    "url": "https://github.com/jacksnxly/opencookie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "fixture:build": "node test-fixture/build-packed.mjs",
    "test": "vitest --root ../../.. run packages/adapters/nuxt/src"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.2",
    "@nuxt/schema": "4.5.2",
    "@opencookie-dev/core": "workspace:^",
    "@opencookie-dev/vue": "workspace:^"
  },
  "peerDependencies": {
    "nuxt": ">=4.5.2 <5.0.0",
    "vue": ">=3.5.0 <4.0.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@vue/server-renderer": "3.5.41",
    "nuxt": "4.5.2",
    "typescript": "5.9.3",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
