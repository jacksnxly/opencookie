{
  "name": "@opencookie-dev/astro",
  "version": "0.2.0",
  "description": "Astro integration for the OpenCookie headless store",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksnxly/opencookie.git",
    "directory": "packages/adapters/astro"
  },
  "homepage": "https://docs.opencookie.dev",
  "bugs": {
    "url": "https://github.com/jacksnxly/opencookie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "fixture:build": "astro build --root test-fixture && node test-fixture/verify-build.mjs",
    "test": "vitest --root ../../.. run packages/adapters/astro/src/index.test.ts"
  },
  "dependencies": {
    "@opencookie-dev/core": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=7.2.4 <8.0.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.9",
    "astro": "7.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
