{
  "name": "opencookie",
  "version": "0.4.1",
  "description": "Initialize OpenCookie in supported web applications",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksnxly/opencookie.git",
    "directory": "packages/cli"
  },
  "homepage": "https://opencookie.dev",
  "bugs": {
    "url": "https://github.com/jacksnxly/opencookie/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencookie": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/semver": "7.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@opencookie-dev/core": "workspace:^",
    "@opencookie-dev/vanilla": "workspace:^",
    "oxc-parser": "0.146.0",
    "parse5": "8.0.1",
    "semver": "7.8.5"
  }
}
