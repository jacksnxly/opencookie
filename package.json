{
  "name": "opencookie-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "OpenCookie consent management monorepo",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "api:check": "node scripts/run-api-extractor.mjs",
    "api:update": "node scripts/run-api-extractor.mjs --local",
    "arch:imports": "depcruise --config .dependency-cruiser.mjs --output-type err packages",
    "arch:manifests": "node scripts/verify-workspace-architecture.mjs",
    "build": "pnpm -r --if-present run build",
    "build:packages": "pnpm --filter \"./packages/**\" --if-present run build",
    "changeset": "changeset",
    "e2e": "node scripts/e2e/run-e2e.mjs",
    "e2e:dx": "node scripts/e2e/run-dx.mjs",
    "e2e:serve": "node scripts/e2e/serve-fixtures.mjs",
    "e2e:storage": "node scripts/e2e/run-storage-e2e.mjs",
    "e2e:storage:safari:serve": "node scripts/e2e/native-safari-storage-harness.mjs",
    "e2e:storage:verify": "node scripts/e2e/verify-storage-results.mjs",
    "e2e:verify": "node scripts/e2e/verify-results.mjs",
    "format": "prettier \"**/*.{js,mjs,cjs,ts,json,yaml,yml}\" --write --ignore-path .prettierignore",
    "format:check": "prettier \"**/*.{js,mjs,cjs,ts,json,yaml,yml}\" --check --ignore-path .prettierignore",
    "lint": "eslint --config eslint.config.mjs . && pnpm --filter @opencookie-fixtures/next-app lint && pnpm --filter @opencookie-fixtures/next-pages lint",
    "size": "pnpm --filter @opencookie-dev/core build && pnpm --filter @opencookie-dev/vanilla build && size-limit && node scripts/verify-core-consumer-sizes.mjs",
    "test": "vitest run",
    "test:architecture-verifier": "node --test scripts/size-budgets.test.mjs scripts/size-budget-units.test.mjs scripts/verify-workspace-architecture.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "test:mutation": "stryker run --incremental",
    "test:mutation:full": "stryker run --incremental --force",
    "test:pain-point-verifier": "node --test scripts/verify-pain-point-coverage.test.mjs",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "typecheck": "tsc -b --pretty false --force",
    "verify": "node scripts/verify-tier.mjs change",
    "verify:arch": "pnpm test:architecture-verifier && pnpm typecheck && pnpm arch:manifests && pnpm build && pnpm arch:imports && pnpm api:check && pnpm size",
    "verify:candidate": "node --test scripts/verify-candidate-manifest.test.mjs && node scripts/verify-candidate-manifest.mjs && pnpm verify:sbom",
    "verify:clean": "node scripts/verify-clean-tree.mjs",
    "verify:codegen": "node scripts/phase4/generate-consent-runtime.mjs --check",
    "verify:fast": "node scripts/verify-tier.mjs fast",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:pain-points": "node scripts/verify-pain-point-coverage.mjs && pnpm test:pain-point-verifier",
    "verify:performance": "pnpm --filter @opencookie-dev/core build && pnpm --filter @opencookie-dev/vanilla build && pnpm --filter @opencookie-fixtures/plain-cdn build && node scripts/performance/run-cdn-cold-load.mjs",
    "verify:release": "node scripts/verify-tier.mjs release",
    "verify:sri": "node scripts/verify-cdn-sri.mjs",
    "version-packages": "changeset version",
    "sbom": "node scripts/generate-sbom.mjs",
    "verify:sbom": "node --test scripts/generate-sbom.test.mjs && node scripts/verify-sbom.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.1",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.0",
    "@playwright/test": "1.62.1",
    "@size-limit/file": "13.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "size-limit": "13.0.3",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "verdaccio": "6.10.0",
    "vitest": "4.1.12"
  }
}
