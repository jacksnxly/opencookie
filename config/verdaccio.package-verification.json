{
  "storage": "./storage",
  "listen": "127.0.0.1:4873",
  "uplinks": {
    "npmjs": {
      "url": "https://registry.npmjs.org/",
      "cache": false
    }
  },
  "web": {
    "enable": false
  },
  "packages": {
    "@opencookie-dev/*": {
      "access": "$all",
      "publish": "$all"
    },
    "opencookie": {
      "access": "$all",
      "publish": "$all"
    },
    "@*/*": {
      "access": "$all",
      "publish": "$all",
      "proxy": "npmjs"
    },
    "**": {
      "access": "$all",
      "publish": "$all",
      "proxy": "npmjs"
    }
  },
  "middlewares": {
    "audit": {
      "enabled": false
    }
  }
}
